PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URL=mongodb+srv://<db-user>:<db-password>@<cluster>/<database>
JWT_SECRET=<generate-a-long-random-secret>
CLOUD_NAME=<cloudinary-cloud-name>
API_KEY=<cloudinary-api-key>
API_SECRET=<cloudinary-api-secret>
FOLDER_NAME=skillora
MAIL_HOST=smtp.gmail.com
MAIL_USER=<email-address>
MAIL_PASS=<email-app-password>
# MAIL_PORT=587          # 465 enables TLS
# MAIL_FROM=Skillora <no-reply@yourdomain.com>
# Optional: add both Razorpay test keys to enable checkout.
# RAZORPAY_KEY_ID=<razorpay-test-key-id>
# RAZORPAY_KEY_SECRET=<razorpay-test-key-secret>

# Used only by `npm run seed` to create the first admin account.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=<strong-password>
